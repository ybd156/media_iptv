#!/bin/bash
# MediaIptv 服务端启动/停止脚本（fnOS FPK）
#
# 退出码很重要：fnOS 依据退出码判断启动是否成功。原实现无论 start 成功与否
# 都 `exit 0`，于是「Node 运行时缺失」「2 秒内崩溃」都会被报告为安装成功。
set -u

# fnOS 给生命周期脚本的 TRIM_* 环境不带 PATH：bash 自己会用内建默认值找命令，
# 但 fork 出去的进程（node → ffmpeg/ffprobe）会继承一个没有 PATH 的环境。
# 显式导出，与飞牛官方模板 cmd/common 的做法保持一致。
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(dirname "$SCRIPT_DIR")"
if [ -z "${TRIM_APPDEST:-}" ]; then
    if [ -d "${APP_ROOT}/app" ]; then
        TRIM_APPDEST="${APP_ROOT}/app"
    else
        TRIM_APPDEST="/var/apps/mediaiptv/target"
    fi
fi
if [ -z "${TRIM_PKGVAR:-}" ]; then
    if [ -d "${APP_ROOT}/var" ]; then
        TRIM_PKGVAR="${APP_ROOT}/var"
    else
        TRIM_PKGVAR="/var/apps/mediaiptv/var"
    fi
fi

ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
    NODE_BIN="${TRIM_APPDEST}/server/node_x86_64"
elif [ "$ARCH" = "aarch64" ]; then
    NODE_BIN="${TRIM_APPDEST}/server/node_aarch64"
else
    NODE_BIN="node"
fi

APP_DIR="${TRIM_APPDEST}/server/app"
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/mediaiptv.pid"

log_msg() {
    # 先确保目录存在再写：原先第一条 STARTING 日志写在 mkdir 之前，全新安装时会丢
    mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"${LOG_FILE}" 2>/dev/null || true
}

fail() {
    local msg="$1"
    log_msg "FAIL: ${msg}"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "${msg}" >"${TRIM_TEMP_LOGFILE}"
    fi
    return 1
}

read_pid() {
    [ -f "${PID_FILE}" ] || return 1
    local pid
    pid=$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    [ -n "${pid}" ] || return 1
    echo "${pid}"
}

# 校验 PID 确实属于本应用：PID 文件残留 + PID 复用会让 status 永远返回「运行中」，
# 于是 start 直接短路，应用再也起不来。
pid_is_ours() {
    local pid="$1"
    kill -0 "${pid}" 2>/dev/null || return 1
    if [ -r "/proc/${pid}/cmdline" ]; then
        # 用 -e 多次匹配而不是 BRE 的 \| 交替，busybox grep 也稳
        tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null | grep -q -e mediaiptv -e "src/index.js" || return 1
    fi
    return 0
}

status() {
    local pid
    pid=$(read_pid) || return 1
    pid_is_ours "${pid}" || return 1
    return 0
}

# 杀整个进程组：ffmpeg 录制进程是 Node 的子进程，只杀父进程会把它们变成孤儿
# 继续录制写盘，而 PID 文件已被删除，之后再也管不到。
# 只有在 pid 确实是自己的进程组组长时才用组杀（setsid 生效时成立）；
# 否则退回单进程杀 —— 此时依赖服务端自己的 SIGTERM handler 去收尾 ffmpeg。
kill_tree() {
    local sig="$1" pid="$2"
    local pgid=""
    if command -v ps >/dev/null 2>&1; then
        pgid=$(ps -o pgid= -p "${pid}" 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -n "${pgid}" ] && [ "${pgid}" = "${pid}" ]; then
        kill -s "${sig}" -- "-${pid}" 2>/dev/null && return 0
    fi
    kill -s "${sig}" "${pid}" 2>/dev/null || true
}

wait_port_free() {
    local port="$1" i=0
    command -v curl >/dev/null 2>&1 || return 0
    while [ $i -lt 15 ]; do
        curl -sf -o /dev/null "http://127.0.0.1:${port}/" 2>/dev/null || return 0
        sleep 1
        i=$((i + 1))
    done
    return 1
}

wait_port_up() {
    local port="$1" i=0
    command -v curl >/dev/null 2>&1 || { sleep 3; return 0; }
    while [ $i -lt 20 ]; do
        if curl -sf -o /dev/null "http://127.0.0.1:${port}/" 2>/dev/null; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

start_process() {
    if status; then
        log_msg "Process already running (PID $(read_pid))"
        return 0
    fi
    # 残留的 PID 文件（进程已死）清掉，否则下次 status 会误判
    rm -f "${PID_FILE}"
    log_msg "========== STARTING =========="
    mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || true

    if [ "${NODE_BIN}" != "node" ] && [ ! -f "${NODE_BIN}" ]; then
        fail "Node runtime not found: ${NODE_BIN}"
        return 1
    fi
    [ "${NODE_BIN}" != "node" ] && chmod +x "${NODE_BIN}" 2>/dev/null

    # 数据目录：优先使用安装向导配置的持久化目录。
    # 安装回调已经做过一次写测试，但目录可能在之后被删除/取消授权/换盘，
    # 所以这里再验一次：宁可回退到应用自己的目录，也不要启动后崩在 mkdirSync / 打开数据库上。
    DATA_DIR="${TRIM_PKGVAR}/data"
    if [ -f "${TRIM_PKGVAR}/wizard_data_path" ]; then
        WIZARD_DATA=$(tr -d '\r\n' <"${TRIM_PKGVAR}/wizard_data_path")
        if [ -n "${WIZARD_DATA}" ]; then
            mkdir -p "${WIZARD_DATA}" 2>/dev/null || true
            if [ -d "${WIZARD_DATA}" ] && (umask 077 && : >"${WIZARD_DATA}/.mediaiptv-write-test.$$") 2>/dev/null; then
                rm -f "${WIZARD_DATA}/.mediaiptv-write-test.$$" 2>/dev/null || true
                DATA_DIR="${WIZARD_DATA}"
            else
                log_msg "警告：向导数据目录 ${WIZARD_DATA} 不可写，回退到 ${TRIM_PKGVAR}/data"
            fi
        fi
    fi
    mkdir -p "${DATA_DIR}" || { fail "无法创建数据目录 ${DATA_DIR}"; return 1; }
    # 注意：不要在这里做 `ln -sfn "${DATA_DIR}" "${TRIM_PKGVAR}/data"`。
    # 当 DATA_DIR 就等于 ${TRIM_PKGVAR}/data 时，该命令会在真实目录里创建
    # data/data -> data 的自引用软链，导致 tar/du/rsync -L 死循环。
    # 应用是通过下面的 DATA_DIR= 环境变量拿到路径的，软链毫无必要。

    # 读取向导配置的端口与管理员密码
    PORT="9527"
    if [ -f "${TRIM_PKGVAR}/server_port" ]; then
        PORT=$(tr -d '\r\n' <"${TRIM_PKGVAR}/server_port")
    fi
    # 端口必须是 1..65535 的整数，否则 server 侧 parseInt 会得到 NaN
    case "${PORT}" in
        ''|*[!0-9]*) PORT="9527" ;;
    esac
    if [ "${PORT}" -lt 1 ] || [ "${PORT}" -gt 65535 ]; then
        log_msg "端口 ${PORT} 非法，回退为 9527"
        PORT="9527"
    fi
    ADMIN_PASSWORD=""
    if [ -f "${TRIM_PKGVAR}/admin_password" ]; then
        ADMIN_PASSWORD=$(tr -d '\r\n' <"${TRIM_PKGVAR}/admin_password")
    fi

    if [ ! -f "${APP_DIR}/src/index.js" ]; then
        fail "App entry not found: ${APP_DIR}/src/index.js"
        return 1
    fi

    wait_port_free "${PORT}" || log_msg "警告：端口 ${PORT} 仍被占用，尝试继续启动"

    log_msg "Exec: ${NODE_BIN} ${APP_DIR}/src/index.js (PORT=${PORT}, DATA_DIR=${DATA_DIR})"
    cd "${APP_DIR}" || { fail "无法进入应用目录 ${APP_DIR}"; return 1; }

    # 用 setsid 让应用成为新会话/进程组组长，停止时才能整组杀掉（连带 ffmpeg）
    if command -v setsid >/dev/null 2>&1; then
        PORT="${PORT}" DATA_DIR="${DATA_DIR}" ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
            setsid "${NODE_BIN}" src/index.js >>"${LOG_FILE}" 2>&1 &
    else
        PORT="${PORT}" DATA_DIR="${DATA_DIR}" ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
            "${NODE_BIN}" src/index.js >>"${LOG_FILE}" 2>&1 &
    fi
    local pid=$!
    printf "%s" "${pid}" >"${PID_FILE}"

    # 用真实监听探测代替固定 sleep 2：固定 sleep 既会把「起得慢」误判为失败，
    # 也会把「起来后 3 秒才崩」误判为成功。
    if wait_port_up "${PORT}"; then
        log_msg "Process started successfully (PID ${pid})"
        return 0
    fi
    if status; then
        # 进程还在但端口没起来：可能被别的服务占用，交由日志排查
        log_msg "Process alive (PID ${pid}) but port ${PORT} not responding yet"
        return 0
    fi
    fail "应用启动失败，请查看日志: ${LOG_FILE}"
    return 1
}

stop_process() {
    log_msg "========== STOPPING =========="
    local pid
    pid=$(read_pid) || { log_msg "No PID file found"; return 0; }

    if pid_is_ours "${pid}"; then
        log_msg "Sending SIGTERM to process group of ${pid}"
        kill_tree TERM "${pid}"
        local wait_count=0
        while kill -0 "${pid}" 2>/dev/null && [ $wait_count -lt 10 ]; do
            sleep 1
            wait_count=$((wait_count + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            log_msg "SIGTERM timeout, sending SIGKILL to ${pid}"
            kill_tree KILL "${pid}"
        fi
        log_msg "Process terminated"
    else
        log_msg "PID file exists but process not running"
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
start)
    start_process || exit 1
    ;;
stop)
    stop_process || exit 1
    ;;
restart | reload)
    stop_process || exit 1
    sleep 1
    start_process || exit 1
    ;;
status)
    if status; then
        echo "Running (PID $(read_pid))"
        exit 0
    fi
    echo "Not running"
    exit 3
    ;;
*)
    echo "Usage: $0 {start|stop|restart|reload|status}"
    exit 1
    ;;
esac
exit 0
